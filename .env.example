# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Library identity ──────────────────────────────────────────────────────────
LIBRARY_NAME=My Public Library
LIBRARY_BRANCH=Main Branch
LIBRARY_PHONE=(555) 123-4567
LIBRARY_EMAIL=info@mylibrary.org
LIBRARY_ADDRESS=123 Library Lane, City, ST 00000
LIBRARY_HOURS=Mon–Thu 10am–8pm · Fri–Sat 10am–5pm
APP_TITLE=Library Checkout

