# ── Library identity ──────────────────────────────────────────────────────────
# Full organisation name — appears on PDF receipts and the page footer
LIBRARY_NAME=Library

# Branch name — appears below the library name on receipts
LIBRARY_BRANCH=Main Branch

# Phone number — shown in the footer and on PDF receipts
LIBRARY_PHONE=

# Email address — shown in the footer (leave blank to hide)
LIBRARY_EMAIL=

# Street address — shown in the footer (leave blank to hide)
LIBRARY_ADDRESS=

# Opening hours — shown in the footer (leave blank to hide)
LIBRARY_HOURS=

# Short title shown in the browser tab, page header, and desktop window title bar
APP_TITLE=Library Checkout

# ── Application settings ──────────────────────────────────────────────────────
# FLASK_ENV=production
# SECRET_KEY=change-me-in-production
# DATABASE_URL=sqlite:///data/library.db
# LOG_LEVEL=INFO

# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable every email feature. When set, the app can
# send patron cards and checkout receipts to patrons via SMTP.
#
# Gmail quick-start:
#   1. Turn on 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#      (Mail → Other → "Library Checkout"). Copy the 16-char code.
#   3. Paste the code into SMTP_PASSWORD below (no spaces).
#
# Other providers: see README "Email configuration" section.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── IMAP (auto-archival to named folders) ────────────────────────────────────
# Optional. When set alongside SMTP, checkouts and patron edits are
# auto-mailed to the library account and *also* APPENDed to a named
# IMAP folder / Gmail label, so they're easy to find later.
# Without IMAP, archival emails still go out via SMTP — they just land
# in the Inbox / Sent Mail folders naturally, not in a dedicated label.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=              # falls back to SMTP_USER when empty
IMAP_PASSWORD=          # falls back to SMTP_PASSWORD when empty
IMAP_USE_SSL=true

# Folder / label names for the auto-archived notifications
LIBRARY_RECEIPTS_LABEL=Library Receipts
LIBRARY_PATRONS_LABEL=Library Patrons

# Master on/off switch for automatic archival. Set to false to stop the
# app from mailing itself on checkouts and patron edits without having
# to clear any other SMTP setting. Default true.
ARCHIVE_NOTIFICATIONS=false

# Master on/off switch for outgoing confirmation emails TO patrons
# whenever a librarian performs a checkout, renewal, or return. Only
# fires when the patron has an email on file AND SMTP is set. Default
# true — set to false to suppress patron confirmations while still
# letting librarians manually click the Email Receipt buttons.
NOTIFY_PATRONS=true
